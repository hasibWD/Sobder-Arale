rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admin role verification against trusted document in admins collection
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }

    // Admins Collection: Protected against public access and user self-assignment
    match /admins/{adminId} {
      // Authenticated users may read their own admin record to verify authorization
      allow get: if isSignedIn() && request.auth.uid == adminId;
      // Nobody can list all admins or create/modify admin records from client SDK
      allow list, create, update, delete: if false;
    }

    // Posts Collection (Poems, Short Stories, Essays)
    match /posts/{postId} {
      // Public can only read published posts. Drafts strictly require admin authentication.
      allow get, list: if resource.data.status == 'published' || isAdmin();

      // Only authorized admin can create, update, or delete posts
      allow create: if isAdmin() &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 300 &&
        request.resource.data.slug is string &&
        request.resource.data.slug.size() > 0 &&
        request.resource.data.slug.size() <= 150 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() > 0 &&
        request.resource.data.status in ['draft', 'published'];

      allow update: if isAdmin() &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() > 0 &&
        request.resource.data.status in ['draft', 'published'];

      allow delete: if isAdmin();
    }

    // Novels Collection
    match /novels/{novelId} {
      // Public can view published / ongoing / completed novels
      allow get, list: if true;

      // Only admin can create, update or delete novels
      allow create: if isAdmin() &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.status in ['ongoing', 'completed'];

      allow update: if isAdmin() &&
        request.resource.data.title is string &&
        request.resource.data.status in ['ongoing', 'completed'];

      allow delete: if isAdmin();

      // Novel Chapters Subcollection
      match /chapters/{chapterId} {
        // Public can only read published chapters in order. Draft chapters remain secret.
        allow get, list: if resource.data.status == 'published' || isAdmin();

        // Only admin can create, update, or delete chapters
        allow create: if isAdmin() &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.chapterNumber is number &&
          request.resource.data.body is string &&
          request.resource.data.body.size() > 0 &&
          request.resource.data.status in ['draft', 'published'];

        allow update: if isAdmin() &&
          request.resource.data.title is string &&
          request.resource.data.chapterNumber is number &&
          request.resource.data.body is string &&
          request.resource.data.status in ['draft', 'published'];

        allow delete: if isAdmin();
      }
    }

    // Author Profile Settings
    match /authors/{authorId} {
      // Author public profile is publicly readable
      allow get, list: if true;
      // Only admin can update author profile
      allow write: if isAdmin();
    }
  }
}
