{
  "entities": {
    "Post": {
      "title": "Post",
      "description": "Represents a literary poem, short story, or essay authored by the website owner",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 300 },
        "slug": { "type": "string", "maxLength": 150 },
        "type": { "type": "string", "enum": ["poem", "story", "essay"] },
        "excerpt": { "type": "string", "maxLength": 500 },
        "body": { "type": "string", "maxLength": 100000 },
        "status": { "type": "string", "enum": ["draft", "published"] }
      },
      "required": ["title", "slug", "type", "body", "status"]
    },
    "Novel": {
      "title": "Novel",
      "description": "Represents a literary serialized or completed novel",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 300 },
        "slug": { "type": "string", "maxLength": 150 },
        "synopsis": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["ongoing", "completed"] }
      },
      "required": ["title", "slug", "synopsis", "status"]
    },
    "Chapter": {
      "title": "Chapter",
      "description": "An ordered chapter under a novel",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 300 },
        "chapterNumber": { "type": "number" },
        "body": { "type": "string", "maxLength": 150000 },
        "status": { "type": "string", "enum": ["draft", "published"] }
      },
      "required": ["title", "chapterNumber", "body", "status"]
    },
    "AuthorProfile": {
      "title": "AuthorProfile",
      "description": "Public biographical information and social links for the author",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "maxLength": 100 },
        "bio": { "type": "string", "maxLength": 3000 },
        "philosophy": { "type": "string", "maxLength": 500 }
      },
      "required": ["displayName"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Security authorization record for the owner/administrator",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["owner", "admin"] }
      },
      "required": ["role"]
    }
  },
  "firestore": {
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Collection of published and draft literary writings"
    },
    "/novels/{novelId}": {
      "schema": { "$ref": "#/entities/Novel" },
      "description": "Collection of novels"
    },
    "/novels/{novelId}/chapters/{chapterId}": {
      "schema": { "$ref": "#/entities/Chapter" },
      "description": "Subcollection of chapters belonging to a specific novel"
    },
    "/authors/{authorId}": {
      "schema": { "$ref": "#/entities/AuthorProfile" },
      "description": "Author biography settings document"
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin allowlist records granting dashboard mutation permissions"
    }
  }
}
